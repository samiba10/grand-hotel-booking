# Rendered at container start by the nginx image (envsubst): ${API_UPSTREAM} only.
# compose: http://gateway-service:8080   railway: http://gateway-service.railway.internal:8080

# Real client IP for the gateway rate limiter: Railway's edge sets X-Real-IP; locally fall back.
map $http_x_real_ip $client_ip {
    ""      $remote_addr;
    default $http_x_real_ip;
}

server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; frame-ancestors 'none'" always;

    # Same-origin API -> gateway: no CORS needed.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $client_ip;
        client_max_body_size 1m;
    }

    # Gateway health (no details) - used by the post-deploy smoke test.
    location = /actuator/health {
        proxy_pass ${API_UPSTREAM};
    }

    # Hashed assets can be cached forever; index.html never.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA routing: unknown paths fall back to index.html
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
