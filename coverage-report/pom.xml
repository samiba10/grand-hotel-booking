<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.grandhotel</groupId>
    <artifactId>grand-hotel-booking</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!--
    Aggregated coverage across ALL modules: common-lib is exercised mostly by the services' tests,
    which per-module reports do not credit. Report: coverage-report/target/site/jacoco-aggregate/
  -->
  <artifactId>coverage-report</artifactId>
  <packaging>pom</packaging>

  <dependencies>
    <dependency><groupId>com.grandhotel</groupId><artifactId>common-lib</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.grandhotel</groupId><artifactId>auth-service</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.grandhotel</groupId><artifactId>fx-service</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.grandhotel</groupId><artifactId>pricing-service</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.grandhotel</groupId><artifactId>booking-service</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.grandhotel</groupId><artifactId>gateway-service</artifactId><version>${project.version}</version></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>aggregate</id>
            <phase>verify</phase>
            <goals><goal>report-aggregate</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
